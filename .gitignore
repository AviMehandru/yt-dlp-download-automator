# Cargo's build directory for the desktop GUI. Reaches several GB after a
# release build, and every byte of it is regenerated by `cargo build`.
gui/src-tauri/target/

# Generated by tauri-build at compile time from tauri.conf.json and the
# capabilities/ files -- not a source.
gui/src-tauri/gen/

# Written by the test runner (tests/run-tests.ps1 -> results.html).
tests/results/

# Created by Step 9 of the installer when it is run from inside a clone.
YT-DLP Installation Files/
