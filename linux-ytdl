#!/usr/bin/env bash
# Usage: ytdl <youtube-url> [download-root-path] [options]
#
# <youtube-url> works identically whether it's a single video, a playlist,
# or a whole channel -- yt-dlp's own extractor tells the two apart, not
# this script, so there's nothing here (or in run_ytdlp.ps1) that branches
# on URL type. The [options] below only ever matter once a session covers
# more than one video; they're harmless no-ops against a single video URL.
#
# Options (any order, after the URL and optional path):
#   --sync              Stop as soon as an already-archived video is hit.
#                        For periodic re-runs against a channel/playlist
#                        you've mostly already archived.
#   --items RANGE        yt-dlp's own --playlist-items syntax, e.g.
#                        --items 1-20  or  --items 5,8,10-15
#   --after YYYYMMDD      yt-dlp's own --dateafter, e.g. --after 20250101
#   --lazy               Start downloading as videos are discovered
#                        instead of enumerating the whole listing first.
#                        Mainly useful on very large channels. No effect
#                        combined with --workers > 1 (see below).
#   --workers N           Download N videos AT THE SAME TIME instead of
#                        one after another. Default 1 (unchanged
#                        behavior). See run_ytdlp.ps1's own comments on
#                        -Workers for what this actually does and why it's
#                        NOT the same as just running ytdl several times
#                        yourself in different terminals -- short version:
#                        this enumerates every video up front so no two
#                        workers can ever be assigned the same one, and
#                        postprocess.ps1 has matching file-locking so
#                        concurrent workers don't corrupt shared manifests.
#                        Start low (2-4) and watch download.log for
#                        rate-limit warnings before going higher.
#   --path PATH           Same as the legacy positional path below, as an
#                        explicit flag -- use this if you also need one of
#                        the options above in the same command.
#
# The second positional argument (a bare path, not starting with "--") is
# still accepted for backward compatibility with existing muscle memory /
# scripts: `ytdl <url> /some/path`. If given, it REPLACES the default
# $HOME/yt-dlp data root (Archive Logs/, Youtube Videos/) for this run only
# -- the pipeline install itself (scripts/, configs/) always stays at
# $HOME/yt-dlp regardless, since this launcher needs a fixed, known
# location to find run_ytdlp.ps1 in the first place, before any argument
# parsing happens. If a relative path is given, run_ytdlp.ps1 resolves it
# to an absolute path itself.
#
# Unlike the Windows .bat version, bash doesn't need any special handling
# here for a URL containing "=" (e.g. ...watch?v=abc123) -- that was a
# cmd.exe-specific quirk (it treats "=" as an argument delimiter alongside
# spaces). Bash only splits unquoted arguments on whitespace, so plain
# "$1" is already safe -- including a custom path containing spaces, as
# long as you quote or escape it the normal shell way when you type it
# (e.g. ytdl <url> "/home/you/My Downloads" or ytdl <url> /home/you/My\ Downloads).

URL="$1"
if [ -z "$URL" ]; then
    echo "Usage: ytdl <youtube-url> [download-root-path] [--sync] [--items RANGE] [--after YYYYMMDD] [--lazy] [--workers N] [--path PATH]" >&2
    exit 1
fi
shift

CUSTOM_PATH=""
BREAK_ON_EXISTING=0
PLAYLIST_ITEMS=""
DATE_AFTER=""
LAZY_PLAYLIST=0
WORKERS=""

# Backward compatibility: if the first remaining argument doesn't start
# with "--", treat it as the legacy positional custom download-root path
# rather than requiring everyone to switch to --path immediately.
if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    CUSTOM_PATH="$1"
    shift
fi

while [ $# -gt 0 ]; do
    case "$1" in
        --sync)
            BREAK_ON_EXISTING=1
            shift
            ;;
        --items)
            PLAYLIST_ITEMS="${2:-}"
            shift 2
            ;;
        --after)
            DATE_AFTER="${2:-}"
            shift 2
            ;;
        --lazy)
            LAZY_PLAYLIST=1
            shift
            ;;
        --workers)
            WORKERS="${2:-}"
            if ! [[ "$WORKERS" =~ ^[0-9]+$ ]] || [ "$WORKERS" -lt 1 ]; then
                echo "Error: --workers requires a positive integer (got: '$WORKERS')" >&2
                exit 1
            fi
            shift 2
            ;;
        --path)
            CUSTOM_PATH="${2:-}"
            shift 2
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Usage: ytdl <youtube-url> [download-root-path] [--sync] [--items RANGE] [--after YYYYMMDD] [--lazy] [--workers N] [--path PATH]" >&2
            exit 1
            ;;
    esac
done

PWSH_ARGS=(-Url "$URL")
[ -n "$CUSTOM_PATH" ] && PWSH_ARGS+=(-DataRoot "$CUSTOM_PATH")
[ "$BREAK_ON_EXISTING" -eq 1 ] && PWSH_ARGS+=(-BreakOnExisting)
[ -n "$PLAYLIST_ITEMS" ] && PWSH_ARGS+=(-PlaylistItems "$PLAYLIST_ITEMS")
[ -n "$DATE_AFTER" ] && PWSH_ARGS+=(-DateAfter "$DATE_AFTER")
[ "$LAZY_PLAYLIST" -eq 1 ] && PWSH_ARGS+=(-LazyPlaylist)
[ -n "$WORKERS" ] && PWSH_ARGS+=(-Workers "$WORKERS")

pwsh -NoProfile -File "$HOME/yt-dlp/scripts/run_ytdlp.ps1" "${PWSH_ARGS[@]}"
